PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Google sign-in. Same OAuth Client ID as VITE_GOOGLE_CLIENT_ID in the
# frontend .env (Google Cloud Console -> APIs & Services -> Credentials).
# Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=

# Profile picture storage (Cloudinary). Cloudinary dashboard -> Settings ->
# API Keys (cloud name is shown at the top of the dashboard).
# Leave blank to disable profile-picture uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo email (sign-up OTP codes + optional low-stock alerts).
# Required in production for sign-up: without BREVO_* set, OTP codes are only
# printed to the server console (development) and sign-up fails in production.
# ENABLE_LOW_STOCK_ALERTS=false disables only the scheduled low-stock job.
ENABLE_LOW_STOCK_ALERTS=false
LOW_STOCK_ALERT_CRON=0 8 * * *
# Brevo dashboard -> SMTP & API -> API Keys -> Generate a new API key
BREVO_API_KEY=
# Must be a sender you've verified in Brevo (Senders, Domains & Dedicated IPs -> Senders)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=StockFlow
